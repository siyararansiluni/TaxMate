generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model advisor_applications {
  application_id   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advisor_id       String           @db.Uuid
  status           String           @default("PENDING") @db.VarChar(20)
  reviewed_by      String?          @db.Uuid
  reviewed_at      DateTime?        @db.Timestamptz(6)
  remarks          String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  advisor_profiles advisor_profiles @relation(fields: [advisor_id], references: [advisor_id], onDelete: NoAction, onUpdate: NoAction)
  users            users?           @relation(fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model advisor_profiles {
  advisor_id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                 @unique @db.Uuid
  qualifications       String?
  experience_years     Int?
  specialization       String?                @db.VarChar(150)
  bio                  String?
  phone                String?                @db.VarChar(20)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  advisor_applications advisor_applications[]
  users                users                  @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deduction_records {
