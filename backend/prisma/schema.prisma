model permissions {
  permission_id    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permission_name  String             @unique @db.VarChar(100)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

model return_documents {
  return_id   String      @db.Uuid
  document_id String      @db.Uuid
  documents   documents   @relation(fields: [document_id], references: [document_id], onDelete: Cascade, onUpdate: NoAction)
  tax_returns tax_returns @relation(fields: [return_id], references: [return_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([return_id, document_id])
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  assigned_at   DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
}

model roles {
  role_id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_name        String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

